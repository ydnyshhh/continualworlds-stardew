diff --git a/StardojoMod/testUtils/TestUtils.cs b/StardojoMod/testUtils/TestUtils.cs
new file mode 100644
index 0000000..e602de1
--- /dev/null
+++ b/StardojoMod/testUtils/TestUtils.cs
@@ -0,0 +1,133 @@
+using System.Reflection;
+using Microsoft.Xna.Framework;
+using StardewModdingAPI;
+using StardewModdingAPI.Events;
+using StardewValley;
+using StardewValley.Inventories;
+using StardewValley.Locations;
+using StardewValley.Menus;
+using StardewValley.Objects;
+using StardewValley.Tools;
+
+namespace testUtils;
+
+/// <summary>Small game helpers referenced by StarDojo but omitted from the upstream source tree.</summary>
+public static class TestUtils
+{
+    public static readonly Dictionary<string, int> ItemIdMap = new()
+    {
+        ["copperBar"] = 334, ["ironBar"] = 335, ["goldBar"] = 336,
+        ["iridiumBar"] = 337, ["wood"] = 388, ["stone"] = 390,
+        ["copper"] = 378, ["iron"] = 380, ["coal"] = 382,
+        ["gold"] = 384, ["iridium"] = 386, ["stardrop"] = 434,
+    };
+
+    private static readonly Dictionary<string, int> ToolIdMap = new()
+    {
+        ["Axw"] = 0, ["How"] = 1, ["FishingRod"] = 2, ["Pickaxe"] = 3,
+        ["WateringCan"] = 4, ["MeleeWeapon"] = 5, ["Slingshot"] = 6,
+    };
+
+    public static void add_chest(int posx, int posy, Color color, Mod mod)
+    {
+        var chest = new Chest(playerChest: true);
+        typeof(Chest).GetField("tint", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(chest, color);
+        Game1.getFarm().objects.Add(new Vector2(posx, posy - 1), chest);
+        mod.Monitor.Log($"Chest added at ({posx}, {posy}).");
+    }
+
+    public static bool callTryToPurchaseItem(object menu, ISalable item, ISalable? heldItem, int count)
+    {
+        MethodInfo? method = menu.GetType().GetMethod("tryToPurchaseItem", BindingFlags.Instance | BindingFlags.NonPublic);
+        return method?.Invoke(menu, new object?[] { item, heldItem, count, 0, 0 }) is true;
+    }
+
+    public static void print_mouse_pos(Mod mod) =>
+        mod.Monitor.Log($"Mouse: ({Game1.getOldMouseX(ui_scale: false)}, {Game1.getOldMouseY(ui_scale: false)})");
+
+    public static void give_tool(string toolName, Mod mod)
+    {
+        Tool tool = ToolIdMap[toolName] switch
+        {
+            0 => new Axe(), 1 => new Hoe(), 2 => new FishingRod(), 3 => new Pickaxe(),
+            4 => new WateringCan(), 5 => new MeleeWeapon(), 6 => new Slingshot(),
+            int id => throw new ArgumentException($"Invalid tool ID: {id}"),
+        };
+        GiveThing(tool, mod);
+    }
+
+    private static void GiveThing(Tool tool, Mod mod)
+    {
+        Inventory items = Game1.player.Items;
+        for (int i = 0; i < items.Count; i++)
+        {
+            if (items[i] is not null)
+                continue;
+            items[i] = tool;
+            return;
+        }
+        mod.Monitor.Log($"Inventory is full; could not add {tool}.", LogLevel.Warn);
+    }
+
+    public static void set_time(Mod mod) => Game1.timeOfDay = 1200;
+
+    public static void tp_player(string location, Mod mod)
+    {
+        if (Game1.getLocationFromName(location) is null)
+        {
+            mod.Monitor.Log($"Location '{location}' was not found.", LogLevel.Warn);
+            return;
+        }
+        Game1.warpFarmer(location, 20, 20, flip: false);
+    }
+
+    public static NPC? GetNearestNPC(Farmer player)
+    {
+        Vector2 playerTile = player.getStandingPosition() / 64f;
+        return Game1.currentLocation.characters
+            .OrderBy(npc => Vector2.Distance(playerTile, npc.getStandingPosition() / 64f))
+            .FirstOrDefault();
+    }
+
+    public static void enterLoadGameMenu(Mod mod, Action onComplete)
+    {
+        int frames = 5;
+        EventHandler<UpdateTickedEventArgs>? handler = null;
+        handler = (_, _) =>
+        {
+            if (Game1.activeClickableMenu is not TitleMenu titleMenu)
+                return;
+            if (frames-- > 0)
+                return;
+            mod.Helper.Events.GameLoop.UpdateTicked -= handler;
+            titleMenu.performButtonAction("Load");
+            onComplete();
+        };
+        mod.Helper.Events.GameLoop.UpdateTicked += handler;
+    }
+
+    public static void loadGame(string which, Mod mod, Action onComplete)
+    {
+        int frames = 5;
+        EventHandler<UpdateTickedEventArgs>? handler = null;
+        handler = (_, _) =>
+        {
+            if (Game1.activeClickableMenu is not TitleMenu || TitleMenu.subMenu is not LoadGameMenu menu)
+                return;
+            if (frames-- > 0)
+                return;
+            mod.Helper.Events.GameLoop.UpdateTicked -= handler;
+            if (menu.MenuSlots[int.Parse(which)] is LoadGameMenu.SaveFileSlot slot)
+                slot.Activate();
+            onComplete();
+        };
+        mod.Helper.Events.GameLoop.UpdateTicked += handler;
+    }
+
+    public static void exitGameToTitle() => Game1.ExitToTitle();
+
+    public static void give_items(string itemId, int amount) =>
+        Game1.player.addItemToInventoryBool(new StardewValley.Object(itemId, amount));
+
+    public static void give_money(int amount) => Game1.player.Money += amount;
+}
